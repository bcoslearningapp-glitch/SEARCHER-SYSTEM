# Copy to .env and fill in locally. NEVER commit .env or real credentials.

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Local database (docker compose) ---
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research
POSTGRES_PORT=5432

# Used when running the API/worker directly on the host (outside compose).
DATABASE_URL=postgresql+psycopg://research:research@localhost:5432/research
REDIS_URL=redis://localhost:6379/0

# --- Host ports ---
API_PORT=8000
WEB_PORT=3000

# --- Storage (source assets; sandboxed root) ---
STORAGE_ROOT=./data/storage

# --- Methodology / constitution versions stamped on audit records ---
METHODOLOGY_VERSION=1.0.0
CONSTITUTION_VERSION=1.0.0

# --- Cloud AI providers (optional; the product works without them) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
